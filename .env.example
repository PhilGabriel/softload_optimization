# Umami Cloud: https://api.umami.is/v1
# Self-hosted: https://umami.example.com/api (or the internal address, e.g. http://umami:3000/api)
UMAMI_API_URL=https://api.umami.is/v1
UMAMI_WEBSITE_ID=

# Either an API key ...
UMAMI_API_KEY=
# ... or a self-hosted login without two-factor authentication
# UMAMI_USERNAME=
# UMAMI_PASSWORD=

# Optional
# TOP_N=20
# Paths matching this regex are never reported, e.g. admin or token routes
# EXCLUDE_REGEX=^/(admin|login)(/|$)

# Optional: purge the file from the Cloudflare cache after each run (all three or none)
# CF_ZONE_ID=
# CF_API_TOKEN=
# CF_PURGE_URL=https://example.com/static/soft-nav-vitals.js
